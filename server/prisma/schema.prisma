generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum Plan {
  FREE
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum QType {
  MCQ
  TRUEFALSE
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Trade {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  nameFr      String
  description String?
  chapters    Chapter[]
  questions   Question[]
  examAttempts ExamAttempt[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Chapter {
  id            String    @id @default(cuid())
  tradeId       String
  trade         Trade     @relation(fields: [tradeId], references: [id])
  number        Int
  name          String
  nameFr        String
  theoryContent String?
  theoryContentEn String?
  questions     Question[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tradeId])
}

model Question {
  id          String    @id @default(cuid())
  tradeId     String
  trade       Trade     @relation(fields: [tradeId], references: [id])
  chapterId   String?
  chapter     Chapter?  @relation(fields: [chapterId], references: [id])
  type        QType     @default(MCQ)
  difficulty  Difficulty @default(MEDIUM)
  question    String
  options     Json?
  answer      String
  explanation String?
  locale      String    @default("fr")
  attemptAnswers ExamAttemptQuestion[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tradeId])
  @@index([chapterId])
  @@index([locale])
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  password      String
  name          String?
  role          Role         @default(STUDENT)
  plan          Plan         @default(FREE)
  subStatus     SubStatus?   @default(ACTIVE)
  stripeId      String?
  resetToken    String?
  resetTokenExpires DateTime?
  subscription  Subscription[]
  examAttempts  ExamAttempt[]
  activityLogs  ActivityLog[]
  chatSessions  ChatSession[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Subscription {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  tradeId       String?
  plan          Plan       @default(MONTHLY)
  status        SubStatus  @default(ACTIVE)
  stripeSubId   String?
  currentPeriod DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

/// ExamAttempt — one completed exam simulation per user
model ExamAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId        String
  trade          Trade    @relation(fields: [tradeId], references: [id])
  score          Float
  totalQuestions Int
  correctCount   Int
  timeSpent      Int      // seconds
  difficulty     String?  // EASY, MEDIUM, HARD, or mixed
  reviewMode     Boolean  @default(false)
  completedAt    DateTime @default(now())

  answers ExamAttemptQuestion[]

  @@index([userId])
  @@index([tradeId])
  @@index([completedAt])
}

/// ExamAttemptQuestion — individual answer within an attempt
model ExamAttemptQuestion {
  id         String  @id @default(cuid())
  attemptId  String
  attempt    ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  userAnswer String
  isCorrect  Boolean

  @@index([attemptId])
  @@index([questionId])
}

/// ActivityLog — audit trail for admin dashboard
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// ChatSession — student AI tutor conversations
model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String?
  source    String   @default("tutor") // "tutor" | "admin"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([userId])
  @@index([updatedAt])
}

/// ChatMessage — individual message within a tutor session
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // 'user' or 'assistant'
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

/// ContactMessage — submissions from the public contact form
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  direction String   @default("inbound")   // inbound = from visitor, outbound = from admin
  status    String   @default("pending")   // pending, replied
  replyText String?  @map("reply_text")
  repliedAt DateTime? @map("replied_at")
  repliedBy String?  @map("replied_by")    // admin user id who replied
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([createdAt])
  @@map("contact_messages")
}
